PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE=schoolpro
DB_SSL_MODE=disable

JWT_SECRET=school-pro-dev-secret-change-in-production
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000

WHATSAPP_ENABLED=false

REDIS_ENABLED=false

# --- Demo account system -----------------------------------------------------
DEMO_FEATURE_ENABLED=true
DEMO_DB_HOST=localhost
DEMO_DB_PORT=5432
DEMO_DB_USERNAME=postgres
DEMO_DB_PASSWORD=admin
DEMO_DB_DATABASE=school_pro_demo
DEMO_JWT_TTL_MINUTES=45
DEMO_RESET_CRON=0 0 */1 * *
DEMO_RESET_ON_BOOT=false
DEMO_WRITE_RATE_LIMIT_PER_MINUTE=20
