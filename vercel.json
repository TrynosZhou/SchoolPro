{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/browser",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://schoolpro-lxv5.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://schoolpro-lxv5.onrender.com/uploads/:path*" },
    { "source": "/((?!ngsw-worker\\.js|ngsw\\.json|safety-worker\\.js|worker-basic\\.min\\.js).)*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(ngsw-worker\\.js|ngsw\\.json|manifest\\.webmanifest|safety-worker\\.js|worker-basic\\.min\\.js)$",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}